    <div class="input-group">
        <label for="serialNumber">Número de Serie (12-13 dígitos)</label>
        <input type="text" id="serialNumber" placeholder="Ej: 1234567890123" inputmode="numeric" pattern="[0-9]*" autofocus>
    </div>

    <button class="generate-btn" onclick="generateBarcode()">✨ Generar Código EAN13</button>

    <div class="error" id="error"></div>

    <div class="barcode-container" id="barcodeContainer">
        <svg id="barcode"></svg>
        <button class="download-btn" onclick="downloadBarcode()">⬇️ Descargar Imagen</button>
    </div>
</div>

<script>
    // Generar al presionar Enter
    document.getElementById('serialNumber').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            generateBarcode();
        }
    });

    function generateBarcode() {
        const serial = document.getElementById('serialNumber').value.trim();
        const errorDiv = document.getElementById('error');
        const container = document.getElementById('barcodeContainer');

        errorDiv.classList.remove('show');
        errorDiv.textContent = '';

        if (!serial) {
            errorDiv.textContent = '⚠️ Por favor ingresa un número de serie';
            errorDiv.classList.add('show');
            container.classList.remove('show');
            return;
        }

        // Validar que tenga 12 o 13 dígitos para EAN13
        if (!/^\d{12,13}$/.test(serial)) {
            errorDiv.textContent = '⚠️ EAN13 requiere 12 o 13 dígitos numéricos';
            errorDiv.classList.add('show');
            container.classList.remove('show');
            return;
        }

        try {
            JsBarcode("#barcode", serial, {
                format: 'EAN13',
                width: 2,
                height: 100,
                displayValue: true,
                fontSize: 18,
                margin: 10
            });
            container.classList.add('show');
        } catch (e) {
            errorDiv.textContent = '❌ Error: ' + e.message;
            errorDiv.classList.add('show');
            container.classList.remove('show');
        }
    }

    function downloadBarcode() {
        const svg = document.getElementById('barcode');
        const svgData = new XMLSerializer().serializeToString(svg);
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        const img = new Image();

        img.onload = function() {
            canvas.width = img.width;
            canvas.height = img.height;
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(img, 0, 0);
            
            const link = document.createElement('a');
            link.download = 'codigo-barras-' + document.getElementById('serialNumber').value + '.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
        };

        img.src = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svgData)));
    }
</script>
