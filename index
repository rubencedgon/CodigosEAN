    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .container {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        padding: 40px;
        max-width: 600px;
        width: 100%;
    }

    h1 {
        color: #667eea;
        text-align: center;
        margin-bottom: 10px;
        font-size: 2em;
    }

    .subtitle {
        text-align: center;
        color: #666;
        margin-bottom: 30px;
        font-size: 0.9em;
    }

    .input-group {
        margin-bottom: 25px;
    }

    label {
        display: block;
        margin-bottom: 8px;
        color: #333;
        font-weight: 600;
    }

    input[type="text"] {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        font-size: 16px;
        transition: all 0.3s;
        -webkit-appearance: none;
        appearance: none;
    }

    input[type="text"]:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .format-group {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 10px;
        margin-bottom: 25px;
    }

    .format-btn {
        padding: 10px;
        border: 2px solid #e0e0e0;
        background: white;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s;
        font-weight: 600;
        color: #666;
    }

    .format-btn:hover {
        border-color: #667eea;
        color: #667eea;
    }

    .format-btn.active {
        background: #667eea;
        border-color: #667eea;
        color: white;
    }

    button.generate-btn {
        width: 100%;
        padding: 15px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 18px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s;
        margin-bottom: 25px;
    }

    button.generate-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
    }

    button.generate-btn:active {
        transform: translateY(0);
    }

    button.generate-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .barcode-container {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 30px;
        text-align: center;
        display: none;
    }

    .barcode-container.show {
        display: block;
        animation: fadeIn 0.5s;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    #barcode {
        margin: 20px 0;
    }

    .download-btn {
        padding: 12px 30px;
        background: #28a745;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        margin-top: 15px;
    }

    .download-btn:hover {
        background: #218838;
        transform: translateY(-2px);
    }

    .error {
        color: #dc3545;
        text-align: center;
        margin-top: 10px;
        display: none;
    }

    .error.show {
        display: block;
    }

    @media (max-width: 480px) {
        .container {
            padding: 25px 20px;
        }

        h1 {
            font-size: 1.5em;
        }

        .format-group {
            grid-template-columns: repeat(2, 1fr);
