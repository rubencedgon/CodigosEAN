<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Generador de códigos de barras</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <style>
    body { font-family: system-ui, -apple-system, Arial; max-width:720px; margin:28px auto; padding:16px; }
    label { display:block; margin-top:12px; }
    input, select, button { padding:8px; font-size:16px; margin-top:6px; width:100%; box-sizing:border-box; }
    #barcodeWrap { margin-top:18px; text-align:center; }
    svg { max-width:100%; height:auto; }
    .controls { display:flex; gap:8px; margin-top:10px; }
    .controls button { flex:1; }
    small { color:#666; }
  </style>
  <!-- JsBarcode desde CDN -->
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
</head>
<body>
  <h1>Generador de códigos de barras</h1>
  <p>Introduce el número de serie y elige el tipo. Recomendado: <strong>Code128</strong> para seriales alfanuméricos.</p>

  <label>Número de serie / texto
    <input id="value" placeholder="Ej: ABC123456" value="ABC123456" />
  </label>

  <label>Formato
    <select id="format">
      <option value="CODE128">Code 128 (alfanumérico, recomendado)</option>
      <option value="EAN13">EAN-13 (solo 13 dígitos)</option>
      <option value="EAN8">EAN-8 (solo 8 dígitos)</option>
      <option value="UPC">UPC (12 dígitos)</option>
      <option value="ITF14">ITF-14</option>
      <option value="CODE39">Code 39</option>
    </select>
  </label>

  <label>Altura (px)
    <input id="height" type="number" value="80" min="20" />
  </label>

  <div class="controls">
    <button id="generate">Generar</button>
    <button id="downloadSvg">Descargar SVG</button>
    <button id="downloadPng">Descargar PNG</button>
  </div>

  <div id="barcodeWrap">
    <svg id="barcode"></svg>
    <div id="msg" style="margin-top:8px"></div>
  </div>

  <script>
    const valueInput = document.getElementById('value');
    const formatSelect = document.getElementById('format');
    const heightInput = document.getElementById('height');
    const svgEl = document.getElementById('barcode');
    const msg = document.getElementById('msg');

    function generar() {
      const val = valueInput.value.trim();
      const fmt = formatSelect.value;
      const h = parseInt(heightInput.value) || 80;
      msg.textContent = '';

      if (!val) { msg.textContent = 'Introduce un número de serie.'; return; }
      // Validaciones básicas para formatos con longitud fija
      if (fmt === 'EAN13' && !/^\d{13}$/.test(val)) { msg.textContent = 'EAN-13 requiere exactamente 13 dígitos numéricos.'; return; }
      if (fmt === 'EAN8'  && !/^\d{8}$/.test(val))  { msg.textContent = 'EAN-8 requiere exactamente 8 dígitos numéricos.'; return; }
      if (fmt === 'UPC'   && !/^\d{12}$/.test(val)) { msg.textContent = 'UPC requiere exactamente 12 dígitos numéricos.'; return; }

      try {
        JsBarcode(svgEl, val, {
          format: fmt,
          lineColor: "#000",
          width: 2,
          height: h,
          displayValue: true,
          fontOptions: "",
          margin: 10
        });
      } catch (e) {
        msg.textContent = 'Error al generar: ' + e.message;
        console.error(e);
      }
    }

    document.getElementById('generate').addEventListener('click', generar);

    document.getElementById('downloadSvg').addEventListener('click', () => {
      const svgData = new XMLSerializer().serializeToString(svgEl);
      const blob = new Blob([svgData], {type: 'image/svg+xml;charset=utf-8'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'barcode.svg';
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('downloadPng').addEventListener('click', () => {
      const svgData = new XMLSerializer().serializeToString(svgEl);
      const canvas = document.createElement('canvas');
      const bbox = svgEl.getBBox();
      const scale = 2; // mejora resolución
      canvas.width = Math.max(300, Math.ceil((bbox.width + 20) * scale));
      canvas.height = Math.ceil((bbox.height + 40) * scale);
      const ctx = canvas.getContext('2d');

      const img = new Image();
      const svgBlob = new Blob([svgData], {type: 'image/svg+xml;charset=utf-8'});
      const url = URL.createObjectURL(svgBlob);
      img.onload = function() {
        ctx.fillStyle = '#fff';
        ctx.fillRect(0,0,canvas.width,canvas.height);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        URL.revokeObjectURL(url);
        canvas.toBlob(function(blob) {
          const link = document.createElement('a');
          link.href = URL.createObjectURL(blob);
          link.download = 'barcode.png';
          link.click();
          URL.revokeObjectURL(link.href);
        }, 'image/png');
      };
      img.onerror = function(){ msg.textContent = 'No se pudo convertir a PNG.'; };
      img.src = url;
    });

    // Generar inicialmente
    generar();
  </script>
</body>
</html>